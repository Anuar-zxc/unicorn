NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: used automatically when the primary model is overloaded (429/5xx)
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# Optional: live web search over trusted legal sites (adilet.zan.kz, kgd.gov.kz, …)
TAVILY_API_KEY=
# Optional: self-hosted Ollama for research answers; leave empty on Vercel
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3:latest
DEEPSEEK_API_KEY=optional_deepseek_key
DEEPSEEK_MODEL=deepseek-chat
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact mailboxes shown in the footer, legal pages and Enterprise CTA
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.kz
NEXT_PUBLIC_SALES_EMAIL=sales@your-domain.kz

# Polar subscriptions (Merchant of Record)
POLAR_ACCESS_TOKEN=polar_oat_your_organization_access_token
POLAR_WEBHOOK_SECRET=polar_whs_your_webhook_secret
POLAR_ENVIRONMENT=sandbox
POLAR_SOLO_PRODUCT_ID=your_solo_product_id
POLAR_FIRM_PRODUCT_ID=your_firm_product_id
POLAR_SOLO_ANNUAL_PRODUCT_ID=your_solo_annual_product_id
POLAR_FIRM_ANNUAL_PRODUCT_ID=your_firm_annual_product_id
# Set both to show the annual toggle on the pricing page
NEXT_PUBLIC_POLAR_SOLO_ANNUAL_PRODUCT_ID=
NEXT_PUBLIC_POLAR_FIRM_ANNUAL_PRODUCT_ID=
# Backward-compatible public aliases accepted by lib/polar.ts:
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=your_solo_product_id
NEXT_PUBLIC_POLAR_BUSINESS_PRODUCT_ID=your_firm_product_id

# Open Data API: https://goszakup.gov.kz/ru/developer/ows_v3
GOSZAKUP_API_TOKEN=your_goszakup_bearer_token
